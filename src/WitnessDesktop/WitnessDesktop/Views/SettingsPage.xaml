<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WitnessDesktop.ViewModels"
             x:Class="WitnessDesktop.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="#080b10"
             Title="Settings"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBg">#080b10</Color>
            <Color x:Key="SidebarBg">#0c0f14</Color>
            <Color x:Key="SidebarBorder">#1e2128</Color>
            <Color x:Key="NavItemActive">#1a1d21</Color>
            <Color x:Key="CardBg">#1a1d21</Color>
            <Color x:Key="CardBorder">#2a2d32</Color>
            <Color x:Key="RowDivider">#22252a</Color>
            <Color x:Key="TextPrimary">#f0f0f0</Color>
            <Color x:Key="TextSecondary">#999999</Color>
            <Color x:Key="TextMuted">#6b6b6b</Color>
            <Color x:Key="AccentCyan">#00d4ff</Color>
            <Color x:Key="AccentPurple">#7c3aed</Color>
            <Color x:Key="ToggleActive">#0d2a3a</Color>
            <Color x:Key="ToggleInactive">#14101f</Color>
            <Color x:Key="CheckActive">#00d4ff</Color>
            <Color x:Key="CheckInactive">#2a2d32</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="220,*" BackgroundColor="{StaticResource PageBg}">

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0"
                BackgroundColor="{StaticResource SidebarBg}"
                Stroke="{StaticResource SidebarBorder}"
                StrokeThickness="0,0,1,0"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>

            <Grid RowDefinitions="*,Auto">

                <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="12,24">

                    <!-- App identity -->
                    <HorizontalStackLayout Spacing="10" Padding="12,0,0,20">
                        <Border BackgroundColor="{StaticResource NavItemActive}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1"
                                WidthRequest="32" HeightRequest="32">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="G" FontSize="16" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="Game Ghost" FontFamily="RajdhaniSemiBold" FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Settings" FontFamily="RajdhaniRegular" FontSize="12"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Nav: Vision -->
                    <Border x:Name="NavVision"
                            BackgroundColor="{StaticResource NavItemActive}"
                            Padding="12,12" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavVision"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="NavVisionLabel"
                               Text="Vision" FontFamily="RajdhaniSemiBold" FontSize="14"
                               TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                    </Border>

                    <!-- Nav: Voice -->
                    <Border x:Name="NavVoice"
                            BackgroundColor="Transparent"
                            Padding="12,12" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavVoice"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="NavVoiceLabel"
                               Text="Voice" FontFamily="RajdhaniRegular" FontSize="14"
                               TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Border>

                    <!-- Nav: Brain -->
                    <Border x:Name="NavBrain"
                            BackgroundColor="Transparent"
                            Padding="12,12" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavBrain"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="NavBrainLabel"
                               Text="Brain" FontFamily="RajdhaniRegular" FontSize="14"
                               TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Border>

                    <!-- Nav: Team -->
                    <Border x:Name="NavTeam"
                            BackgroundColor="Transparent"
                            Padding="12,12" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavTeam"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="NavTeamLabel"
                               Text="Team" FontFamily="RajdhaniRegular" FontSize="14"
                               TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>

                <!-- Sidebar footer: About + Back -->
                <VerticalStackLayout Grid.Row="1" Spacing="8" Padding="12,0,12,20">

                    <!-- About line -->
                    <HorizontalStackLayout Spacing="6" Padding="12,0">
                        <Label Text="5DOF AI Studio" FontFamily="RajdhaniRegular" FontSize="12"
                               TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                        <Label Text="·" FontSize="12" TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center"/>
                        <Label Text="{Binding AppVersion}" FontFamily="RajdhaniRegular" FontSize="12"
                               TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Back button -->
                    <Border BackgroundColor="Transparent"
                            Padding="12,12" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#x2190;" FontSize="16"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            <Label Text="Back" FontFamily="RajdhaniRegular" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <Grid Grid.Column="1">

            <!-- ══════════════════════════════════════════════ -->
            <!-- ── TAB 1: VISION ──────────────────────────── -->
            <!-- ══════════════════════════════════════════════ -->
            <ScrollView x:Name="VisionPanel">
                <VerticalStackLayout Spacing="0" Padding="40,32"
                                     MaximumWidthRequest="800" HorizontalOptions="Start">

                    <Label Text="Vision" FontFamily="Krophed" FontSize="22"
                           TextColor="{StaticResource TextPrimary}" CharacterSpacing="2"
                           Margin="0,0,0,24"/>

                    <VerticalStackLayout Spacing="12">

                        <!-- Vision Model -->
                        <Label Text="Model" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,0,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Gemini 2.5 Flash"
                                           FontFamily="RajdhaniSemiBold" FontSize="16"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Set by active agent"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#0d2a1a"
                                        Padding="10,5" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                    <Label Text="Active" FontFamily="RajdhaniSemiBold" FontSize="12"
                                           TextColor="#4ade80"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Capture Rate -->
                        <Label Text="Capture" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,12,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CaptureRate}"
                                       FontFamily="RajdhaniSemiBold" FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Frequency adapts per agent — chess uses board-change detection, generalist uses timed intervals"
                                       FontFamily="RajdhaniRegular" FontSize="13"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ══════════════════════════════════════════════ -->
            <!-- ── TAB 2: VOICE ───────────────────────────── -->
            <!-- ══════════════════════════════════════════════ -->
            <ScrollView x:Name="VoicePanel" IsVisible="False">
                <VerticalStackLayout Spacing="0" Padding="40,32"
                                     MaximumWidthRequest="800" HorizontalOptions="Start">

                    <Label Text="Voice" FontFamily="Krophed" FontSize="22"
                           TextColor="{StaticResource TextPrimary}" CharacterSpacing="2"
                           Margin="0,0,0,24"/>

                    <VerticalStackLayout Spacing="12">

                        <!-- Voice Provider (read-only) -->
                        <Label Text="Provider" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,0,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding VoiceEngine}"
                                           FontFamily="RajdhaniSemiBold" FontSize="16"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Voice provider is set per agent configuration"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#0d2a1a"
                                        Padding="10,5" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                    <Label Text="Active" FontFamily="RajdhaniSemiBold" FontSize="12"
                                           TextColor="#4ade80"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Voice Gender (read-only) -->
                        <Label Text="Gender" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,12,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding VoiceGenderDisplay}"
                                       FontFamily="RajdhaniSemiBold" FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Gender is assigned per agent — Leroy and RASA are male, Wasp is female"
                                       FontFamily="RajdhaniRegular" FontSize="13"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ── Barge-In ── -->
                        <Label Text="Barge-In" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,12,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Allow interruptions"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="When enabled, the AI can speak up with observations even while you're talking"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsBargeInEnabled}"
                                        OnColor="{StaticResource AccentCyan}"
                                        ThumbColor="White"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Feature gate notice -->
                        <Border BackgroundColor="#0d0a16"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="0.5" Padding="16,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Voice selection coming soon"
                                       FontFamily="RajdhaniSemiBold" FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="Custom voice selection and additional voice options will be available in a future update."
                                       FontFamily="RajdhaniRegular" FontSize="13"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ══════════════════════════════════════════════ -->
            <!-- ── TAB 3: BRAIN ───────────────────────────── -->
            <!-- ══════════════════════════════════════════════ -->
            <ScrollView x:Name="BrainPanel" IsVisible="False">
                <VerticalStackLayout Spacing="0" Padding="40,32"
                                     MaximumWidthRequest="800" HorizontalOptions="Start">

                    <Label Text="Brain" FontFamily="Krophed" FontSize="22"
                           TextColor="{StaticResource TextPrimary}" CharacterSpacing="2"
                           Margin="0,0,0,24"/>

                    <VerticalStackLayout Spacing="12">

                        <!-- Brain Model (read-only) -->
                        <Label Text="Model" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,0,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding BrainModel}"
                                           FontFamily="RajdhaniSemiBold" FontSize="16"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Analyzes screen captures and generates game insights"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#0d2a1a"
                                        Padding="10,5" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                    <Label Text="Active" FontFamily="RajdhaniSemiBold" FontSize="12"
                                           TextColor="#4ade80"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Inference Mode (read-only) -->
                        <Label Text="Inference" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,12,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Cloud Only"
                                       FontFamily="RajdhaniSemiBold" FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="All AI processing runs in the cloud via API providers"
                                       FontFamily="RajdhaniRegular" FontSize="13"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Diagnostics -->
                        <Label Text="Diagnostics" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,12,0,4"/>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="120,*">
                                    <Label Grid.Column="0" Text="Brain Provider"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding BrainProvider}"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource RowDivider}"/>
                                <Grid ColumnDefinitions="120,*">
                                    <Label Grid.Column="0" Text="Voice Provider"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding VoiceProviderDisplay}"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource RowDivider}"/>
                                <Grid ColumnDefinitions="120,*">
                                    <Label Grid.Column="0" Text="Voice Engine"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding VoiceEngine}"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ══════════════════════════════════════════════ -->
            <!-- ── TAB 4: TEAM ────────────────────────────── -->
            <!-- ══════════════════════════════════════════════ -->
            <ScrollView x:Name="TeamPanel" IsVisible="False">
                <VerticalStackLayout Spacing="0" Padding="40,32"
                                     MaximumWidthRequest="800" HorizontalOptions="Start">

                    <Label Text="Team" FontFamily="Krophed" FontSize="22"
                           TextColor="{StaticResource TextPrimary}" CharacterSpacing="2"
                           Margin="0,0,0,24"/>

                    <VerticalStackLayout Spacing="16">

                        <!-- ── Configure with Claude CTA ── -->
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,20">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="16">

                                <!-- Header -->
                                <HorizontalStackLayout Spacing="12">
                                    <Border BackgroundColor="#0d2a3a"
                                            Stroke="#1a3d50"
                                            StrokeThickness="1"
                                            WidthRequest="40" HeightRequest="40">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                        <Label Text="⚡" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="Configure with Claude"
                                               FontFamily="RajdhaniSemiBold" FontSize="16"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label x:Name="TeamStatusLabel"
                                               Text="Claude CLI detected"
                                               FontFamily="RajdhaniRegular" FontSize="13"
                                               TextColor="{StaticResource TextMuted}"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <!-- Description -->
                                <Label Text="Ghost Team lets your AI agents delegate complex tasks to Claude Code running in the background. Claude researches, plans, and executes — your agent narrates the results."
                                       FontFamily="RajdhaniRegular" FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       LineHeight="1.4"/>

                                <!-- Status indicator -->
                                <Border x:Name="TeamConnectionStatus"
                                        BackgroundColor="#0d2a1a"
                                        Stroke="#1a3d2a"
                                        StrokeThickness="1"
                                        Padding="16,10">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="8">
                                        <Border BackgroundColor="#4ade80"
                                                WidthRequest="8" HeightRequest="8">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                        </Border>
                                        <Label x:Name="TeamConnectionLabel"
                                               Text="Ready — launches automatically when you connect to a game"
                                               FontFamily="RajdhaniRegular" FontSize="13"
                                               TextColor="#4ade80" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </Border>

                        <!-- ── Auto-Launch ── -->
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="24,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Auto-launch on connect"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Start a Team session automatically when you connect to a game"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding TeamAutoLaunch}"
                                        OnColor="{StaticResource AccentCyan}"
                                        ThumbColor="White"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- ── Permission Mode Checklist ── -->
                        <Label Text="Permissions" FontFamily="RajdhaniSemiBold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" Margin="4,4,0,2"/>

                        <Label Text="Control how much autonomy Claude has during Team sessions"
                               FontFamily="RajdhaniRegular" FontSize="13"
                               TextColor="{StaticResource TextMuted}" Margin="4,0,0,8"/>

                        <!-- Ask for everything (default) -->
                        <Border x:Name="PermDefault"
                                BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource AccentCyan}"
                                StrokeThickness="1" Padding="20,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPermDefaultSelected"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="PermDefaultCheck"
                                        Grid.Column="0"
                                        BackgroundColor="{StaticResource AccentCyan}"
                                        WidthRequest="20" HeightRequest="20"
                                        Margin="0,0,14,0" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Label Text="✓" FontSize="12" TextColor="Black" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Ask for everything"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Claude asks before every action"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Auto-approve edits -->
                        <Border x:Name="PermEdits"
                                BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="20,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPermEditsSelected"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="PermEditsCheck"
                                        Grid.Column="0"
                                        BackgroundColor="{StaticResource CheckInactive}"
                                        WidthRequest="20" HeightRequest="20"
                                        Margin="0,0,14,0" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Label Text="" FontSize="12" TextColor="Black"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Auto-approve edits"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Claude edits freely, asks for other actions"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Plan only -->
                        <Border x:Name="PermPlan"
                                BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="20,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPermPlanSelected"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="PermPlanCheck"
                                        Grid.Column="0"
                                        BackgroundColor="{StaticResource CheckInactive}"
                                        WidthRequest="20" HeightRequest="20"
                                        Margin="0,0,14,0" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Label Text="" FontSize="12" TextColor="Black"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Plan only"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Claude plans but waits for your approval to act"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Auto-approve most -->
                        <Border x:Name="PermAuto"
                                BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="20,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPermAutoSelected"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="PermAutoCheck"
                                        Grid.Column="0"
                                        BackgroundColor="{StaticResource CheckInactive}"
                                        WidthRequest="20" HeightRequest="20"
                                        Margin="0,0,14,0" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Label Text="" FontSize="12" TextColor="Black"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Auto-approve most"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Claude acts freely on most tasks"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Full autonomy -->
                        <Border x:Name="PermBypass"
                                BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1" Padding="20,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPermBypassSelected"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="PermBypassCheck"
                                        Grid.Column="0"
                                        BackgroundColor="{StaticResource CheckInactive}"
                                        WidthRequest="20" HeightRequest="20"
                                        Margin="0,0,14,0" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Label Text="" FontSize="12" TextColor="Black"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Full autonomy"
                                           FontFamily="RajdhaniSemiBold" FontSize="14"
                                           TextColor="#f87171"/>
                                    <Label Text="Claude acts without asking — use with caution"
                                           FontFamily="RajdhaniRegular" FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>
</ContentPage>
