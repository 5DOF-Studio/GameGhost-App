<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WitnessDesktop.Models.Timeline"
             xmlns:mainmodels="clr-namespace:WitnessDesktop.Models"
             xmlns:utils="clr-namespace:WitnessDesktop.Utilities"
             xmlns:views="clr-namespace:WitnessDesktop.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WitnessDesktop.Views.TimelineView">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Direct Message Template: full bubble when expanded, icon token when collapsed -->
            <DataTemplate x:Key="DirectMessageTemplate" x:DataType="models:TimelineEvent">
                <Grid>
                    <!-- Expanded: full message bubble -->
                    <views:DirectMessageBubble IsVisible="{Binding IsExpanded}" />

                    <!-- Collapsed: compact icon token -->
                    <Border IsVisible="{Binding IsCollapsed}"
                            BackgroundColor="{Binding CapsuleColor}"
                            Stroke="{Binding CapsuleStroke}"
                            StrokeThickness="1.5"
                            WidthRequest="36"
                            HeightRequest="36"
                            Margin="0,3,6,3"
                            ToolTipProperties.Text="{Binding Summary}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding Icon}"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Proactive Alert Template: full card when expanded, icon token when collapsed -->
            <DataTemplate x:Key="ProactiveAlertTemplate" x:DataType="models:TimelineEvent">
                <Grid>
                    <!-- Expanded: urgency-colored alert card -->
                    <views:ProactiveAlertView IsVisible="{Binding IsExpanded}" />

                    <!-- Collapsed: compact icon token -->
                    <Border IsVisible="{Binding IsCollapsed}"
                            BackgroundColor="{Binding CapsuleColor}"
                            Stroke="{Binding CapsuleStroke}"
                            StrokeThickness="1.5"
                            WidthRequest="36"
                            HeightRequest="36"
                            Margin="0,3,6,3"
                            ToolTipProperties.Text="{Binding Summary}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding Icon}"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Tool Call Template: operational status chip -->
            <DataTemplate x:Key="ToolCallTemplate" x:DataType="models:TimelineEvent">
                <Grid>
                    <!-- Expanded: operational status chip with icon-led layout -->
                    <Border IsVisible="{Binding IsExpanded}"
                            BackgroundColor="#0860A0FF"
                            Stroke="#4060A0FF"
                            StrokeThickness="1.5"
                            Padding="12,7"
                            Margin="0,3,9,3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="{Binding Icon}"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Opacity="0.85"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Summary}"
                                   FontSize="16"
                                   FontFamily="Rajdhani-SemiBold"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding ToolCall.DurationLabel}"
                                   FontSize="13"
                                   FontFamily="Rajdhani-Regular"
                                   TextColor="{StaticResource TextMuted}"
                                   Opacity="0.6"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding ToolCall.HasDuration}" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Collapsed: compact icon token -->
                    <Border IsVisible="{Binding IsCollapsed}"
                            BackgroundColor="#1060A0FF"
                            Stroke="#3060A0FF"
                            StrokeThickness="1.5"
                            WidthRequest="32"
                            HeightRequest="32"
                            Margin="0,3,5,3"
                            ToolTipProperties.Text="{Binding Summary}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding Icon}"
                               WidthRequest="16"
                               HeightRequest="16"
                               Opacity="0.7"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Default Event Template: icon + text pill when expanded, small text capsule when collapsed -->
            <DataTemplate x:Key="DefaultEventTemplate" x:DataType="models:TimelineEvent">
                <Grid>
                    <!-- Expanded: standalone icon + text-only pill -->
                    <HorizontalStackLayout IsVisible="{Binding IsExpanded}"
                                           Spacing="6">
                        <Image Source="{Binding Icon}"
                               WidthRequest="24"
                               HeightRequest="24"
                               VerticalOptions="Center" />
                        <Border BackgroundColor="{Binding CapsuleColor}"
                                Stroke="{Binding CapsuleStroke}"
                                StrokeThickness="1.5"
                                Padding="12,6"
                                Margin="0,2"
                                MaximumWidthRequest="520"
                                ToolTipProperties.Text="{Binding FullContent}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding FullContent}"
                                   FontSize="17"
                                   FontFamily="Rajdhani-Regular"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Collapsed: small text capsule (no icon) -->
                    <Border IsVisible="{Binding IsCollapsed}"
                            BackgroundColor="{Binding CapsuleColor}"
                            Stroke="{Binding CapsuleStroke}"
                            StrokeThickness="1"
                            Padding="8,3"
                            Margin="0,2,4,2"
                            MaximumWidthRequest="120"
                            HeightRequest="24"
                            ToolTipProperties.Text="{Binding Summary}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Summary}"
                               FontSize="11"
                               FontFamily="Rajdhani-Regular"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Archived Boundary Marker -->
            <DataTemplate x:Key="ArchivedTemplate" x:DataType="models:TimelineEvent">
                <Border BackgroundColor="#10808080"
                        Stroke="#20808080"
                        StrokeThickness="1"
                        Padding="14,6"
                        Margin="0,8,0,4"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="history_clock.png"
                               WidthRequest="14"
                               HeightRequest="14"
                               Opacity="0.4"
                               VerticalOptions="Center" />
                        <Label Text="Archived"
                               FontSize="12"
                               FontFamily="Rajdhani-Regular"
                               TextColor="{StaticResource TextMuted}"
                               Opacity="0.5"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>

            <!-- Image Card Template: rounded image when expanded, icon token when collapsed -->
            <DataTemplate x:Key="ImageCardTemplate" x:DataType="models:TimelineEvent">
                <Grid Padding="12,4">
                    <!-- Expanded: rounded image card -->
                    <Border IsVisible="{Binding IsExpanded}"
                            BackgroundColor="#18000000"
                            Stroke="#3000BCD4"
                            StrokeThickness="1.5"
                            Margin="0,4"
                            MaximumWidthRequest="420"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image Source="{Binding Media.FilePath}"
                                   Aspect="AspectFill"
                                   MinimumHeightRequest="180"
                                   MaximumHeightRequest="300" />

                            <!-- Optional title overlay -->
                            <Border BackgroundColor="#CC000000"
                                    Padding="10,5"
                                    VerticalOptions="Start"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding Media.Title, Converter={StaticResource IsNotNullConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12,12,0,0" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Media.Title}"
                                       FontSize="14"
                                       FontFamily="Orbitron-Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Collapsed: compact icon token -->
                    <Border IsVisible="{Binding IsCollapsed}"
                            BackgroundColor="{Binding CapsuleColor}"
                            Stroke="{Binding CapsuleStroke}"
                            StrokeThickness="1.5"
                            WidthRequest="36"
                            HeightRequest="36"
                            Margin="0,3,6,3"
                            ToolTipProperties.Text="{Binding Summary}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding Icon}"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Video Card Template: MediaElement when expanded, icon token when collapsed -->
            <DataTemplate x:Key="VideoCardTemplate" x:DataType="models:TimelineEvent">
                <Grid Padding="12,4">
                    <!-- Expanded: video card with MediaElement -->
                    <Border IsVisible="{Binding IsExpanded}"
                            BackgroundColor="#18000000"
                            Stroke="#307C4DFF"
                            StrokeThickness="1.5"
                            Margin="0,4"
                            MaximumWidthRequest="420"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid>
                            <toolkit:MediaElement Source="{Binding Media.FilePath}"
                                                  ShouldAutoPlay="False"
                                                  ShouldMute="True"
                                                  ShouldShowPlaybackControls="False"
                                                  MinimumHeightRequest="180"
                                                  MaximumHeightRequest="300"
                                                  Aspect="AspectFill"
                                                  Loaded="OnVideoMediaLoaded"
                                                  MediaOpened="OnVideoMediaOpened"
                                                  MediaEnded="OnVideoMediaEnded"
                                                  PositionChanged="OnVideoPositionChanged"
                                                  BindingContextChanged="OnVideoBindingContextChanged"
                                                  Unloaded="OnVideoMediaUnloaded" />

                            <!-- Optional title overlay -->
                            <Border BackgroundColor="#CC000000"
                                    Padding="10,5"
                                    VerticalOptions="Start"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding Media.Title, Converter={StaticResource IsNotNullConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12,12,0,0" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Media.Title}"
                                       FontSize="14"
                                       FontFamily="Orbitron-Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Collapsed: compact icon token -->
                    <Border IsVisible="{Binding IsCollapsed}"
                            BackgroundColor="{Binding CapsuleColor}"
                            Stroke="{Binding CapsuleStroke}"
                            StrokeThickness="1.5"
                            WidthRequest="36"
                            HeightRequest="36"
                            Margin="0,3,6,3"
                            ToolTipProperties.Text="{Binding Summary}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding Icon}"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Flat vertical timeline: newest on top -->
    <CollectionView x:Name="TimelineCollection"
                    ItemsSource="{Binding TimelineFeed.Events}"
                    SelectionMode="None"
                    ItemsUpdatingScrollMode="KeepScrollOffset">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="3" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <utils:TimelineEventTemplateSelector
                DirectMessageTemplate="{StaticResource DirectMessageTemplate}"
                ProactiveAlertTemplate="{StaticResource ProactiveAlertTemplate}"
                ToolCallTemplate="{StaticResource ToolCallTemplate}"
                ArchivedTemplate="{StaticResource ArchivedTemplate}"
                ImageCardTemplate="{StaticResource ImageCardTemplate}"
                VideoCardTemplate="{StaticResource VideoCardTemplate}"
                DefaultTemplate="{StaticResource DefaultEventTemplate}" />
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentView>
